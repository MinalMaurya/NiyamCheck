# NiyamCheck Frontend Environment Configuration Template

# API Base URL (leave empty for same-origin / relative reverse proxy)
VITE_API_BASE_URL=

# Mobile App Release Configuration
# Set this to the official HTTPS Android APK release/download URL (e.g. GitHub Releases APK or HTTPS download page).
# Example: https://github.com/<org>/<repo>/releases/download/v1.0.0/niyamcheck-v1.0.0.apk
# Do NOT use localhost, 127.0.0.1, or an unverified/fake URL. Leave blank when unreleased.
VITE_MOBILE_APP_DOWNLOAD_URL=

# Optional Version Overrides (defaults to Android 8.0+ and v1.0.0 if omitted)
# VITE_MOBILE_APP_ANDROID_VERSION=Android 8.0+
# VITE_MOBILE_APP_VERSION=v1.0.0
